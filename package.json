{
  "name": "legacy-provisioning-migration",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan:secrets": "secretlint \"**/*\"",
    "verify": "npm run typecheck && npm test && npm run build && npm run scan:secrets"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@types/node": "^22.18.8",
    "secretlint": "^11.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
